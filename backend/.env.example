BACKEND_HOST=127.0.0.1
BACKEND_PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

ADMIN_TOKEN_TTL_HOURS=12

PAYMENT_WEBHOOK_SECRET=change-this-webhook-secret
SESSION_TTL_DAYS=7
MAX_BODY_BYTES=15728640

# Local runtime fallback. For production this will be replaced by PostgreSQL + object storage.
BACKEND_DATA_DIR=backend/data
BACKEND_STORAGE_DIR=backend/storage

# Leave empty to use local JSON store. Fill this to use PostgreSQL.
DATABASE_URL=

# Optional cloud storage for DSLR and finalized booth photos. Keep the service
# role key only on the local Go backend; never expose it as a VITE_ variable.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=potobox-galleries

# Optional Windows .NET Hardware Agent. When configured, DSLR and printer
# requests are forwarded to this local service instead of invoking gphoto2.
HARDWARE_AGENT_URL=http://127.0.0.1:8790
HARDWARE_AGENT_API_KEY=change-this-agent-key
